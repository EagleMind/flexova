{
  "name": "@flexova/html",
  "version": "0.0.0",
  "description": "Render Flexova (.flexova) documents as static, self-contained .flexova.html pages that need no JavaScript and no network.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EagleMind/flexova.git",
    "directory": "packages/html"
  },
  "homepage": "https://github.com/EagleMind/flexova#readme",
  "bugs": "https://github.com/EagleMind/flexova/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "flexova",
    "html",
    "static",
    "offline",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@flexova/core": "workspace:*",
    "@flexova/viewer": "workspace:*"
  }
}
