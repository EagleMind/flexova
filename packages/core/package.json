{
  "name": "@flexova/core",
  "version": "0.0.0",
  "description": "Read, write and validate Flexova (.flexova) documents. Runs in browsers, WebViews and Node.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EagleMind/flexova.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/EagleMind/flexova#readme",
  "bugs": "https://github.com/EagleMind/flexova/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "flexova",
    "document",
    "reflowable",
    "epub",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "saxes": "^6.0.0"
  }
}
